package models3d

import (
	"encoding/json"
	"fmt"
	"net/http"
	"strconv"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/mdaxf/iac/controllers/common"
	"github.com/mdaxf/iac/logger"
	"github.com/mdaxf/iac/models"
	"github.com/mdaxf/iac/services"
)

var (
	threeDModelDocService *services.ThreeDModelDocumentService
)

// SetThreeDDocServices sets the service instances for 3D model documents
func SetThreeDDocServices(docService *services.ThreeDModelDocumentService) {
	threeDModelDocService = docService
}

// ThreeDModelDocumentController handles simplified 3D model document management
// where each version is a separate document
type ThreeDModelDocumentController struct{}

// =============================================================================
// 3D MODEL DOCUMENT CRUD OPERATIONS
// =============================================================================

// CreateThreeDModelDocument creates a new 3D model document
// POST /api/3dstudio/documents
func (c *ThreeDModelDocumentController) CreateThreeDModelDocument(ctx *gin.Context) {
	iLog := logger.Log{ModuleName: logger.API, User: "System", ControllerName: "ThreeDModelDocument"}
	startTime := time.Now()
	defer func() {
		elapsed := time.Since(startTime)
		iLog.PerformanceWithDuration("threedmodeldoc.CreateThreeDModelDocument", elapsed)
	}()

	body, clientid, user, err := common.GetRequestBodyandUser(ctx)
	if err != nil {
		iLog.Error(fmt.Sprintf("Error reading body: %v", err))
		ctx.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}
	iLog.ClientID = clientid
	iLog.User = user

	var req models.ThreeDModelDocumentCreateRequest
	if err := json.Unmarshal(body, &req); err != nil {
		iLog.Error(fmt.Sprintf("Error unmarshalling request: %v", err))
		ctx.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	doc, err := threeDModelDocService.CreateModelDocument(ctx.Request.Context(), &req, user)
	if err != nil {
		iLog.Error(fmt.Sprintf("Error creating 3D model document: %v", err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	iLog.Info(fmt.Sprintf("Created 3D model document: %s (Model: %s, Version: %d)", doc.ID, doc.ModelID, doc.Version))
	ctx.JSON(http.StatusOK, gin.H{"data": doc})
}

// GetThreeDModelDocument retrieves a 3D model document by ID
// GET /api/3dstudio/documents/:id
func (c *ThreeDModelDocumentController) GetThreeDModelDocument(ctx *gin.Context) {
	iLog := logger.Log{ModuleName: logger.API, User: "System", ControllerName: "ThreeDModelDocument"}
	startTime := time.Now()
	defer func() {
		elapsed := time.Since(startTime)
		iLog.PerformanceWithDuration("threedmodeldoc.GetThreeDModelDocument", elapsed)
	}()

	_, clientid, user, err := common.GetRequestBodyandUser(ctx)
	if err != nil {
		iLog.Error(fmt.Sprintf("Error reading body: %v", err))
		ctx.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}
	iLog.ClientID = clientid
	iLog.User = user

	docID := ctx.Param("id")
	if docID == "" {
		ctx.JSON(http.StatusBadRequest, gin.H{"error": "Document ID is required"})
		return
	}

	doc, err := threeDModelDocService.GetModelDocument(ctx.Request.Context(), docID)
	if err != nil {
		iLog.Error(fmt.Sprintf("Error getting 3D model document: %v", err))
		ctx.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	ctx.JSON(http.StatusOK, gin.H{"data": doc})
}

