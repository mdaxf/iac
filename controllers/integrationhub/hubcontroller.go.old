package integrationhub

import (
	"fmt"
	"net/http"
	"time"

	"github.com/gin-gonic/gin"
	"github.com/mdaxf/iac/controllers/common"
	"github.com/mdaxf/iac/documents"
	"github.com/mdaxf/iac/logger"
	"github.com/mdaxf/iac/models"
	"github.com/mdaxf/iac/services"
)

// HubController handles hierarchical integration hub HTTP requests
type HubController struct {
}

// getHubService creates a new HubService with MongoDB connection
func (hc *HubController) getHubService() (*services.HubService, error) {
	factory := documents.GetDocFactory()
	if factory == nil {
		return nil, fmt.Errorf("document factory not available")
	}

	docDB, err := factory.GetDB("default")
	if err != nil || docDB == nil {
		return nil, fmt.Errorf("document database not available: %w", err)
	}

	return services.NewHubService(docDB), nil
}

// =====================================================
// Hub Instance Endpoints
// =====================================================

// ListInstances handles GET /api/integration-hub/instances
func (hc *HubController) ListInstances(c *gin.Context) {
	iLog := logger.Log{ModuleName: logger.API, User: "System", ControllerName: "HubController"}
	startTime := time.Now()
	defer func() {
		elapsed := time.Since(startTime)
		iLog.PerformanceWithDuration("integrationhub.ListInstances", elapsed)
	}()

	_, user, clientid, err := common.GetRequestUser(c)
	if err != nil {
		iLog.Error(fmt.Sprintf("Get user information Error: %v", err))
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}
	iLog.ClientID = clientid
	iLog.User = user

	hubService, err := hc.getHubService()
	if err != nil {
		iLog.Error(fmt.Sprintf("Failed to get hub service: %v", err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Service not available"})
		return
	}
	instances, err := hubService.ListInstances(c.Request.Context())
	if err != nil {
		iLog.Error(fmt.Sprintf("Failed to list instances: %v", err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{"data": instances, "count": len(instances)})
}

// GetInstance handles GET /api/integration-hub/instances/:id
func (hc *HubController) GetInstance(c *gin.Context) {
	iLog := logger.Log{ModuleName: logger.API, User: "System", ControllerName: "HubController"}
	startTime := time.Now()
	defer func() {
		elapsed := time.Since(startTime)
		iLog.PerformanceWithDuration("integrationhub.GetInstance", elapsed)
	}()

	_, user, clientid, err := common.GetRequestUser(c)
	if err != nil {
		iLog.Error(fmt.Sprintf("Get user information Error: %v", err))
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}
	iLog.ClientID = clientid
	iLog.User = user

	instanceID := c.Param("id")
	if instanceID == "" {
		c.JSON(http.StatusBadRequest, gin.H{"error": "instance ID is required"})
		return
	}

	hubService, err := hc.getHubService()
	if err != nil {
		iLog.Error(fmt.Sprintf("Failed to get hub service: %v", err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Service not available"})
		return
	}
	instance, err := hubService.GetInstanceByID(c.Request.Context(), instanceID)
	if err != nil {
		iLog.Error(fmt.Sprintf("Failed to get instance: %v", err))
		c.JSON(http.StatusNotFound, gin.H{"error": err.Error()})
		return
	}

	c.JSON(http.StatusOK, gin.H{"data": instance})
}

// CreateInstance handles POST /api/integration-hub/instances
func (hc *HubController) CreateInstance(c *gin.Context) {
	iLog := logger.Log{ModuleName: logger.API, User: "System", ControllerName: "HubController"}
	startTime := time.Now()
	defer func() {
		elapsed := time.Since(startTime)
		iLog.PerformanceWithDuration("integrationhub.CreateInstance", elapsed)
	}()

	_, user, clientid, err := common.GetRequestUser(c)
	if err != nil {
		iLog.Error(fmt.Sprintf("Get user information Error: %v", err))
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}
	iLog.ClientID = clientid
	iLog.User = user

	var instance models.HubInstance
	if err := c.ShouldBindJSON(&instance); err != nil {
		iLog.Error(fmt.Sprintf("Failed to bind JSON: %v", err))
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}

	instance.CreatedBy = user
	instance.ModifiedBy = user

	hubService, err := hc.getHubService()
	if err != nil {
		iLog.Error(fmt.Sprintf("Failed to get hub service: %v", err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": "Service not available"})
		return
	}
	err = hubService.CreateInstance(c.Request.Context(), &instance)
	if err != nil {
		iLog.Error(fmt.Sprintf("Failed to create instance: %v", err))
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}

	iLog.Info(fmt.Sprintf("Created hub instance: %s", instance.ID))
	c.JSON(http.StatusCreated, gin.H{"data": instance})
}

